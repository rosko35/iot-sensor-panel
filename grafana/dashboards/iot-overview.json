          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"humidity\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
