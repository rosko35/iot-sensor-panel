# Copy to .env and adjust. .env is git-ignored - never commit real secrets.
# docker compose reads this file automatically for variable substitution.

LOG_LEVEL=INFO

# --- InfluxDB 2 (first-run auto setup) --------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx
INFLUX_ORG=iot
INFLUX_BUCKET=sensors
INFLUX_RETENTION=30d
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INFLUX_TOKEN=dev-only-influx-token-change-me

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Simulator --------------------------------------------------------------
SIM_DEVICES=sim-living-room,sim-server-room,sim-greenhouse,sim-garage
SIM_INTERVAL=5
# 1 = real time; 288 = one simulated day every 5 minutes
SIM_TIME_SCALE=1
# DEVICE:START:DURATION:DELTA[:EVERY] (seconds), comma separated
SIM_SPIKE=sim-server-room:120:180:9:900
# DEVICE:START:DURATION[:EVERY] (seconds), comma separated
SIM_SILENCE=sim-garage:300:150:900

# --- Alert notifications ----------------------------------------------------
# Leave empty to log alerts to the ingest service console only.
# Create a bot with @BotFather, then get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
